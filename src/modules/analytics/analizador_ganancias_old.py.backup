class AnalisisGananciasApp:
    """Clase principal para el análisis de ganancias"""
    
    def __init__(self, root, user_data):
        self.root = root
        self.root.title("Análisis de Ganancias - Disfruleg")
        self.root.geometry("1400x900")

        # ✅ FIX: En Windows, actualizar antes de crear widgets complejos
        if platform.system() == 'Windows':
            self.root.update()

        # ✅ FIX Z-INDEX: Forzar ventana al frente (compatible con Windows)
        try:
            self.root.lift()
            if platform.system() != 'Windows':
                # En macOS/Linux funciona bien
                self.root.attributes('-topmost', True)
                self.root.after(100, lambda: self.root.attributes('-topmost', False))
            else:
                # En Windows, usamos un approach diferente
                self.root.after(100, lambda: self.root.lift())
            self.root.focus_force()
        except Exception as e:
            # Si falla, continuamos sin elevar la ventana
            print(f"Warning: No se pudo elevar la ventana: {e}")

        self.user_data = user_data if isinstance(user_data, dict) else {}
        self.es_admin = (self.user_data.get('rol', '') == 'admin')

        # Conectar a la base de datos
        try:
            self.conn = conectar()
            self.cursor = self.conn.cursor()
        except mysql.connector.Error as err:
            messagebox.showerror("Error de conexión", f"No se pudo conectar a la base de datos:\n{err}")
            self.root.destroy()
            return

        self.all_products = []
        self.search_var = ctk.StringVar()

        self.create_interface()
        self.load_analysis()
    
