    def create_summary_section(self):
        """Crear sección de resumen con tarjetas"""
        summary_container = ctk.CTkFrame(self.root, fg_color="transparent")
        summary_container.pack(fill="x", padx=20, pady=(15, 10))
        
        cards_frame = ctk.CTkFrame(summary_container, fg_color="transparent")
        cards_frame.pack(fill="x")
        
        self.total_ventas_var = ctk.StringVar(value="$0.00")
        self.total_costos_var = ctk.StringVar(value="$0.00")
        self.ganancia_total_var = ctk.StringVar(value="$0.00")
        self.margen_promedio_var = ctk.StringVar(value="0%")
        
        self.create_summary_card(cards_frame, "💰 Ventas Totales", self.total_ventas_var, COLORS['success'], 0)
        self.create_summary_card(cards_frame, "💸 Costos Totales", self.total_costos_var, COLORS['accent'], 1)
        self.create_summary_card(cards_frame, "💵 Ganancia Total", self.ganancia_total_var, "#2196F3", 2)
        self.create_summary_card(cards_frame, "📊 Margen Promedio", self.margen_promedio_var, "#FF5722", 3)
        
        for i in range(4):
            cards_frame.columnconfigure(i, weight=1, uniform="cards")
    
    def create_summary_card(self, parent, title, text_var, color, column):
        """Crear una tarjeta de resumen"""
        card = ctk.CTkFrame(parent, fg_color=color, corner_radius=15, height=100)
        card.grid(row=0, column=column, padx=8, pady=5, sticky="ew")
        card.grid_propagate(False)
        
        card_content = ctk.CTkFrame(card, fg_color="transparent")
        card_content.pack(fill="both", expand=True, padx=15, pady=15)
        
        ctk.CTkLabel(card_content, text=title, font=FONTS['body'], text_color="white", anchor="w").pack(fill="x")
        ctk.CTkLabel(card_content, textvariable=text_var, font=("Arial", 24, "bold"), text_color="white", anchor="w").pack(fill="x", pady=(5, 0))
    
