        headers_frame.grid_columnconfigure(4, weight=1, minsize=110)
        headers_frame.grid_columnconfigure(5, weight=1, minsize=110)
        headers_frame.grid_columnconfigure(6, weight=1, minsize=110)
        headers_frame.grid_columnconfigure(7, weight=1, minsize=120)
        headers_frame.grid_columnconfigure(8, weight=1, minsize=110)
        headers_frame.grid_columnconfigure(9, weight=1, minsize=110)
