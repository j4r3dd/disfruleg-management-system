    def eliminar_compra(self, compra):
        """Eliminar una compra"""
        if not messagebox.askyesno(
            "Confirmar Eliminación",
            f"¿Está seguro de eliminar esta compra?\n\n"
            f"Proveedor: {compra['proveedor']}\n"
            f"Folio: {compra['folio_factura']}\n"
            f"Total: ${float(compra['total_con_impuestos']):,.2f}"
        ):
            return
        
        try:
            # Obtener datos para ajustar stock
            self.cursor.execute("""
                SELECT cantidad_compra, id_producto 
                FROM compra 
                WHERE id_compra = %s
            """, (compra['id_compra'],))
            compra_data = self.cursor.fetchone()
            
            if compra_data:
                # Eliminar compra
                self.cursor.execute("DELETE FROM compra WHERE id_compra = %s", (compra['id_compra'],))
                
                # Ajustar stock
                self.cursor.execute("""
                    UPDATE producto 
                    SET stock = stock - %s 
                    WHERE id_producto = %s
                """, (compra_data['cantidad_compra'], compra_data['id_producto']))
            
            self.conn.commit()
            messagebox.showinfo("Éxito", "Compra eliminada exitosamente")
            self.load_compras()
            
        except Exception as e:
            self.conn.rollback()
            messagebox.showerror("Error", f"Error al eliminar compra: {str(e)}")
    
