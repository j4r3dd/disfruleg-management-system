    def load_compras(self):
        """Cargar compras desde la base de datos"""
        try:
            query = """
                SELECT 
                    c.id_compra,
                    c.fecha_compra,
                    p.nombre_producto,
                    p.unidad_producto,
                    c.cantidad_compra,
                    c.precio_unitario_compra,
                    c.folio_factura,
                    c.proveedor,
                    c.rfc_proveedor,
                    c.metodo_pago,
                    c.forma_pago,
                    c.subtotal,
                    c.iva,
                    c.importe_ieps,
                    c.total_con_impuestos,
                    c.notas
                FROM compra c
                INNER JOIN producto p ON c.id_producto = p.id_producto
                ORDER BY c.fecha_compra DESC, c.id_compra DESC
            """
            self.cursor.execute(query)
            self.all_compras = self.cursor.fetchall()
            self.mostrar_compras(self.all_compras)
        except Exception as e:
            messagebox.showerror("Error", f"Error al cargar compras: {str(e)}")
    
