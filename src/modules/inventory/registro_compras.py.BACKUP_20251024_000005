        filtro = self.filtro_var.get().lower()
        if not filtro:
            self.mostrar_compras(self.all_compras)
            return
        
        compras_filtradas = [
            c for c in self.all_compras
            if filtro in c['nombre_producto'].lower()
            or filtro in (c['proveedor'] or "").lower()
            or filtro in (c['folio_factura'] or "").lower()
            or filtro in (c['rfc_proveedor'] or "").lower()
        ]
        
        self.mostrar_compras(compras_filtradas)
    
