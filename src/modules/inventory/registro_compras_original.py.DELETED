# -*- coding: utf-8 -*-
"""
DISFRULEG - Purchase Registration (Modernized with Fiscal & Financial Data)
Módulo de registro de compras con información fiscal completa
Versión 2.0 - Octubre 2025
"""

import os
import customtkinter as ctk
from tkinter import messagebox
import mysql.connector
from src.database.conexion import conectar
from decimal import Decimal
from datetime import datetime
from src.auth.auth_manager import AuthManager
from src.theme import COLORS, FONTS
import re

# Import calendar picker
try:
    from tkcalendar import DateEntry
    CALENDAR_AVAILABLE = True
except ImportError:
    CALENDAR_AVAILABLE = False
    print("Warning: tkcalendar not available. Using text entry for dates.")

class ComprasApp:
    def __init__(self, root, user_data):
        self.root = root
        self.root.title("Registro de Compras (Fiscal) - Disfruleg")
        self.root.geometry("1600x900")

        # Datos del usuario autenticado
        self.user_data = user_data
        self.es_admin = (self.user_data['rol'] == 'admin')
        self.auth_manager = AuthManager()
        
        # Connect to database
        self.conn = conectar()
        self.cursor = self.conn.cursor()
        
        # Variables del formulario
        self.selected_product = ctk.StringVar()
        self.cantidad_var = ctk.StringVar()
        self.precio_var = ctk.StringVar()
        self.fecha_compra_var = ctk.StringVar(value=datetime.now().strftime("%Y-%m-%d"))  # Fecha de la factura/compra
        self.fecha_registro_var = ctk.StringVar(value=datetime.now().strftime("%Y-%m-%d"))  # Fecha de registro en sistema
        
        # NUEVAS VARIABLES FISCALES
        self.folio_var = ctk.StringVar()
        self.proveedor_var = ctk.StringVar()
        self.rfc_var = ctk.StringVar()
        self.incluir_iva_var = ctk.BooleanVar(value=True)  # Checkbox para IVA (por defecto SÍ)
        self.ieps_var = ctk.StringVar(value="0.00")
        self.tasa_interes_var = ctk.StringVar(value="0.00")
        self.metodo_pago_var = ctk.StringVar(value="PUE")
        self.forma_pago_var = ctk.StringVar(value="03")
        self.notas_var = ctk.StringVar()
        
        self.filtro_var = ctk.StringVar()
        self.all_compras = []
        
        self.load_productos()
        self.load_catalogos()
        self.create_interface()
        self.load_compras()
        
        # ✅ Protocol for window closing
        self.root.protocol("WM_DELETE_WINDOW", self.on_closing)
        
    def load_productos(self):
        """Cargar productos desde la base de datos"""
        self.cursor.execute("SELECT id_producto, nombre_producto, unidad_producto, es_especial FROM producto ORDER BY nombre_producto")
        self.productos = self.cursor.fetchall()
        
    def crear_producto_nuevo(self):
        """Ventana emergente para crear un producto nuevo sobre la marcha"""
        
        # Crear ventana emergente
        ventana_producto = ctk.CTkToplevel(self.root)
        ventana_producto.title("Crear Producto Nuevo")
        ventana_producto.geometry("500x450")
        ventana_producto.transient(self.root)
        ventana_producto.grab_set()
        
        # Centrar ventana
        ventana_producto.update_idletasks()
        x = (ventana_producto.winfo_screenwidth() // 2) - (500 // 2)
        y = (ventana_producto.winfo_screenheight() // 2) - (450 // 2)
        ventana_producto.geometry(f"500x450+{x}+{y}")
        
        # Frame principal
        main_frame = ctk.CTkFrame(ventana_producto, fg_color="transparent")
        main_frame.pack(fill="both", expand=True, padx=30, pady=30)
        
        # Título
        ctk.CTkLabel(
            main_frame,
            text="Crear Producto Nuevo",
            font=("Arial", 20, "bold"),
            text_color=COLORS['primary']
        ).pack(pady=(0, 20))
        
        # Variables
        nombre_var = ctk.StringVar()
        unidad_var = ctk.StringVar(value="PIEZA")
        
        # Nombre del producto
        ctk.CTkLabel(
            main_frame,
            text="Nombre del Producto: *",
            font=("Arial", 12, "bold"),
            anchor="w"
        ).pack(fill="x", pady=(0, 5))
        
        nombre_entry = ctk.CTkEntry(
            main_frame,
            textvariable=nombre_var,
            height=40,
            font=("Arial", 12),
            placeholder_text="Ej: Nutella 240g"
        )
        nombre_entry.pack(fill="x", pady=(0, 15))
        nombre_entry.focus_set()
        
        # Unidad
        ctk.CTkLabel(
            main_frame,
            text="Unidad de Medida: *",
            font=("Arial", 12, "bold"),
            anchor="w"
        ).pack(fill="x", pady=(0, 5))
        
        unidades_comunes = [
            "PIEZA", "KG", "GRAMO", "LITRO", "ML", 
            "CAJA", "PAQUETE", "BOLSA", "UNIDAD"
        ]
        
        unidad_combo = ctk.CTkComboBox(
            main_frame,
            variable=unidad_var,
            values=unidades_comunes,
            height=40,
            font=("Arial", 12)
        )
        unidad_combo.pack(fill="x", pady=(0, 20))
        
        # Info adicional
        info_frame = ctk.CTkFrame(main_frame, fg_color=("gray90", "gray20"), corner_radius=8)
        info_frame.pack(fill="x", pady=(0, 20))
        
        ctk.CTkLabel(
            info_frame,
            text="ℹ️ El producto se creará inmediatamente\ny estará disponible para esta compra",
            font=("Arial", 10),
            text_color="gray",
            justify="left"
        ).pack(padx=15, pady=10)
        
        # Variable para el resultado
        resultado = {'success': False, 'producto': None}
        
        def guardar_producto():
            """Guardar el nuevo producto"""
            # FIX: Get value directly from entry widget for PyInstaller compatibility
            # In frozen apps, StringVar.get() sometimes doesn't work correctly
            try:
                nombre = nombre_entry.get().strip()
            except Exception as e:
                print(f"Warning: Could not get value from nombre_entry: {e}")
                nombre = nombre_var.get().strip()

            try:
                unidad = unidad_combo.get().strip()
            except Exception as e:
                print(f"Warning: Could not get value from unidad_combo: {e}")
                unidad = unidad_var.get().strip()

            # Debug logging
            print(f"DEBUG: Creating product - Nombre: '{nombre}', Unidad: '{unidad}'")

            # Validaciones
            if not nombre:
                messagebox.showerror("Error", "El nombre del producto es obligatorio", parent=ventana_producto)
                nombre_entry.focus_set()
                return
            
            if len(nombre) < 3:
                messagebox.showerror("Error", "El nombre debe tener al menos 3 caracteres", parent=ventana_producto)
                nombre_entry.focus_set()
                return
            
            if not unidad:
                messagebox.showerror("Error", "Debe seleccionar una unidad", parent=ventana_producto)
                return
            
            try:
                # Verificar si ya existe
                self.cursor.execute(
                    "SELECT id_producto FROM producto WHERE nombre_producto = %s",
                    (nombre,)
                )
                if self.cursor.fetchone():
                    messagebox.showerror(
                        "Producto Duplicado",
                        f"Ya existe un producto con el nombre:\n'{nombre}'",
                        parent=ventana_producto
                    )
                    return
                
                # Insertar producto nuevo
                query = """
                    INSERT INTO producto (
                        nombre_producto,
                        unidad_producto,
                        stock,
                        es_especial
                    ) VALUES (%s, %s, 0, FALSE)
                """
                
                self.cursor.execute(query, (nombre, unidad))
                self.conn.commit()
                
                # Obtener ID del producto recién creado
                id_producto = self.cursor.lastrowid
                
                # Guardar resultado
                resultado['success'] = True
                resultado['producto'] = {
                    'id_producto': id_producto,
                    'nombre_producto': nombre,
                    'unidad_producto': unidad,
                    'es_especial': False
                }
                
                messagebox.showinfo(
                    "Éxito",
                    f"Producto creado exitosamente:\n{nombre} ({unidad})",
                    parent=ventana_producto
                )
                
                ventana_producto.destroy()
                
            except Exception as e:
                self.conn.rollback()
                messagebox.showerror(
                    "Error",
                    f"Error al crear producto:\n{str(e)}",
                    parent=ventana_producto
                )
        
        # Botones
        button_frame = ctk.CTkFrame(main_frame, fg_color="transparent")
        button_frame.pack(fill="x", pady=(0, 0))
        
        ctk.CTkButton(
            button_frame,
            text="Cancelar",
            command=ventana_producto.destroy,
            fg_color="gray",
            hover_color="darkgray",
            width=200,
            height=40,
            font=("Arial", 12, "bold")
        ).pack(side="left", expand=True, padx=5)
        
        ctk.CTkButton(
            button_frame,
            text="Crear Producto",
            command=guardar_producto,
            fg_color=COLORS['success'],
            hover_color=COLORS['success_hover'],
            width=200,
            height=40,
            font=("Arial", 12, "bold")
        ).pack(side="right", expand=True, padx=5)
        
        # Esperar a que se cierre la ventana
        ventana_producto.wait_window()
        
        # Si se creó el producto, recargar lista y seleccionarlo
        if resultado['success']:
            # Recargar productos
            self.load_productos()
            
            # Actualizar combo
            productos_nombres = [f"{p['nombre_producto']} ({p['unidad_producto']})" for p in self.productos]
            self.producto_combo.configure(values=productos_nombres)
            self.productos_completos = productos_nombres.copy()
            
            # Seleccionar el producto recién creado
            nuevo_producto = resultado['producto']
            texto_nuevo = f"{nuevo_producto['nombre_producto']} ({nuevo_producto['unidad_producto']})"
            self.selected_product.set(texto_nuevo)
            self.producto_combo.set(texto_nuevo)
            
            # Limpiar búsqueda
            self.producto_search_var.set("")
    
    def load_catalogos(self):
        """Cargar catálogos de métodos y formas de pago"""
        try:
            # Métodos de pago
            self.cursor.execute("SELECT clave, descripcion FROM cat_metodo_pago WHERE activo = TRUE")
            self.metodos_pago = self.cursor.fetchall()
            
            # Formas de pago
            self.cursor.execute("SELECT clave, descripcion FROM cat_forma_pago WHERE activo = TRUE")
            self.formas_pago = self.cursor.fetchall()
        except:
            # Si no existen las tablas, usar valores por defecto
            self.metodos_pago = [
                {'clave': 'PUE', 'descripcion': 'Pago en una sola exhibición'},
                {'clave': 'PPD', 'descripcion': 'Pago en parcialidades o diferido'}
            ]
            self.formas_pago = [
                {'clave': '01', 'descripcion': 'Efectivo'},
                {'clave': '02', 'descripcion': 'Cheque nominativo'},
                {'clave': '03', 'descripcion': 'Transferencia electrónica'},
                {'clave': '04', 'descripcion': 'Tarjeta de crédito'},
                {'clave': '28', 'descripcion': 'Tarjeta de débito'},
                {'clave': '99', 'descripcion': 'Por definir'}
            ]
        
    def create_interface(self):
        """Crear la interfaz de usuario moderna"""
        self.create_header()
        self.create_main_content()
        self.create_status_bar()
    
    def create_header(self):
        """Create modern header with EXIT button"""
        header_frame = ctk.CTkFrame(self.root, fg_color=COLORS['secondary'], height=70)
        header_frame.pack(fill="x")
        header_frame.pack_propagate(False)
        
        header_content = ctk.CTkFrame(header_frame, fg_color="transparent")
        header_content.pack(fill="both", expand=True, padx=20, pady=15)
        
        # ✅ LEFT: EXIT BUTTON + TITLE
        left_frame = ctk.CTkFrame(header_content, fg_color="transparent")
        left_frame.pack(side="left", fill="y")
        
        # ✅ EXIT BUTTON (igual al de user_manager.py)
        exit_btn = ctk.CTkButton(
            left_frame,
            text="⎋",  # Símbolo de escape/salir
            width=40,
            height=40,
            corner_radius=8,
            fg_color="transparent",
            hover_color=COLORS.get('accent', '#e74c3c'),
            font=("Arial", 20),
            text_color="white",
            border_width=0,
            command=self.on_closing
        )
        exit_btn.pack(side="left", padx=(0, 15))
        
        # Título con badge de "FISCAL"
        title_frame = ctk.CTkFrame(left_frame, fg_color="transparent")
        title_frame.pack(side="left")
        
        ctk.CTkLabel(
            title_frame,
            text="REGISTRO DE COMPRAS",
            font=FONTS['title'],
            text_color="white"
        ).pack(side="left")
        
        # Badge fiscal
        badge = ctk.CTkFrame(title_frame, fg_color=COLORS['success'], corner_radius=5)
        badge.pack(side="left", padx=10)
        ctk.CTkLabel(
            badge,
            text="FISCAL 2.0",
            font=("Arial", 10, "bold"),
            text_color="white"
        ).pack(padx=8, pady=2)
        
        # User info on the right
        user_frame = ctk.CTkFrame(header_content, fg_color="transparent")
        user_frame.pack(side="right")
        
        role_color = COLORS['success'] if self.es_admin else COLORS['primary']
        role_text = "ADMINISTRADOR" if self.es_admin else "USUARIO"
        
        ctk.CTkLabel(
            user_frame,
            text=f"Usuario: {self.user_data['nombre_completo']}",
            font=FONTS['body'],
            text_color="lightgray"
        ).pack(side="left", padx=10)
        
        ctk.CTkLabel(
            user_frame,
            text=f"Rol: {role_text}",
            font=FONTS['body_bold'],
            text_color=role_color
        ).pack(side="left")
    
    def create_main_content(self):
        """Create main content area"""
        main_container = ctk.CTkFrame(self.root, fg_color="transparent")
        main_container.pack(fill="both", expand=True, padx=20, pady=15)
        
        # Left side: Registration form (con scroll)
        left_frame = ctk.CTkScrollableFrame(
            main_container, 
            fg_color=("gray90", "gray20"), 
            corner_radius=15,
            width=550
        )
        left_frame.pack(side="left", fill="both", padx=(0, 10), pady=0)
        
        self.create_registro_section(left_frame)
        
        # Right side: Purchase list
        right_frame = ctk.CTkFrame(main_container, fg_color="transparent")
        right_frame.pack(side="right", fill="both", expand=True, pady=0)
        
        self.create_lista_section(right_frame)
    
    def create_registro_section(self, parent):
        """Crear sección de registro de nuevas compras CON CAMPOS FISCALES"""
        # Header
        header = ctk.CTkFrame(parent, fg_color="transparent")
        header.pack(fill="x", padx=20, pady=(20, 15))
        
        ctk.CTkLabel(
            header,
            text="REGISTRAR NUEVA COMPRA",
            font=FONTS['subtitle'],
            text_color=COLORS['primary']
        ).pack(anchor="w")
        
        # Form container
        form_frame = ctk.CTkFrame(parent, fg_color="transparent")
        form_frame.pack(fill="both", expand=True, padx=20, pady=(0, 20))
        
        # =====================================================
        # SECCIÓN 1: DATOS BÁSICOS DEL PRODUCTO
        # =====================================================
        self.create_section_header(form_frame, "📦 DATOS DEL PRODUCTO")
        
        # Producto
        ctk.CTkLabel(
            form_frame,
            text="Producto: *",
            font=FONTS['subheader'],
            anchor="w"
        ).pack(fill="x", pady=(10, 5))
        
        # Frame para búsqueda y combo
        producto_search_frame = ctk.CTkFrame(form_frame, fg_color="transparent")
        producto_search_frame.pack(fill="x", pady=(0, 15))
        
        # Entry de búsqueda
        self.producto_search_var = ctk.StringVar()
        self.producto_search_entry = ctk.CTkEntry(
            producto_search_frame,
            textvariable=self.producto_search_var,
            placeholder_text="Escribe 2-3 letras para buscar...",
            height=35,
            font=FONTS['body']
        )
        self.producto_search_entry.pack(fill="x", pady=(0, 5))

        # ComboBox de productos
        productos_nombres = [f"{p['nombre_producto']} ({p['unidad_producto']})" for p in self.productos]
        self.producto_combo = ctk.CTkComboBox(
            producto_search_frame,
            variable=self.selected_product,
            values=productos_nombres,
            state="readonly",
            height=35,
            font=FONTS['body']
        )
        self.producto_combo.pack(fill="x", pady=(0, 5))

        # ✨ NUEVO: Botón para crear producto
        btn_nuevo_producto = ctk.CTkButton(
            producto_search_frame,
            text="➕ Crear Producto Nuevo",
            command=self.crear_producto_nuevo,
            fg_color=COLORS['success'],
            hover_color=COLORS['success_hover'],
            height=35,
            font=("Arial", 11, "bold")
        )
        btn_nuevo_producto.pack(fill="x")

        # Conectar búsqueda con filtrado
        # Use both trace AND key release for better compatibility
        self.producto_search_var.trace("w", self.filtrar_productos)
        self.producto_search_entry.bind("<KeyRelease>", self.filtrar_productos)
        self.productos_completos = productos_nombres.copy()

        # Add instruction label
        info_label = ctk.CTkLabel(
            producto_search_frame,
            text="💡 Escribe en el campo de búsqueda y selecciona del menú desplegable",
            font=("Arial", 9),
            text_color="gray"
        )
        info_label.pack(fill="x", pady=(5, 0))
        
        # ✅ Fecha de Compra (fecha de la factura)
        ctk.CTkLabel(
            form_frame,
            text="Fecha de Compra / Factura: *",
            font=FONTS['subheader'],
            anchor="w"
        ).pack(fill="x", pady=(0, 5))

        # Date picker frame
        fecha_compra_frame = ctk.CTkFrame(form_frame, fg_color="transparent")
        fecha_compra_frame.pack(fill="x", pady=(0, 5))

        if CALENDAR_AVAILABLE:
            # Use calendar picker
            self.fecha_compra_entry = DateEntry(
                fecha_compra_frame,
                width=25,
                background='darkblue',
                foreground='white',
                borderwidth=2,
                date_pattern='yyyy-mm-dd',
                font=("Arial", 11)
            )
            self.fecha_compra_entry.pack(side="left", fill="x", expand=True)

            # Update the StringVar when date changes
            def update_fecha_compra(event=None):
                self.fecha_compra_var.set(self.fecha_compra_entry.get())

            self.fecha_compra_entry.bind("<<DateEntrySelected>>", update_fecha_compra)

            # Calendar icon button
            calendar_btn = ctk.CTkButton(
                fecha_compra_frame,
                text="📅",
                width=40,
                height=35,
                command=lambda: self.fecha_compra_entry.drop_down(),
                fg_color=COLORS.get('primary', '#2196F3'),
                hover_color=COLORS.get('primary_hover', '#1976D2')
            )
            calendar_btn.pack(side="left", padx=(5, 0))
        else:
            # Fallback to text entry
            self.fecha_compra_entry = ctk.CTkEntry(
                fecha_compra_frame,
                textvariable=self.fecha_compra_var,
                height=35,
                font=FONTS['body'],
                placeholder_text="YYYY-MM-DD"
            )
            self.fecha_compra_entry.pack(fill="x")

        ctk.CTkLabel(
            form_frame,
            text="ℹ️ Fecha que aparece en la factura (haz clic en 📅 para calendario)",
            font=("Arial", 10),
            text_color="gray"
        ).pack(fill="x", pady=(0, 15))
        
        # ✅ Fecha de Registro (fecha en que se captura en el sistema)
        ctk.CTkLabel(
            form_frame,
            text="Fecha de Registro en Sistema: *",
            font=FONTS['subheader'],
            anchor="w"
        ).pack(fill="x", pady=(0, 5))

        # Date picker frame
        fecha_registro_frame = ctk.CTkFrame(form_frame, fg_color="transparent")
        fecha_registro_frame.pack(fill="x", pady=(0, 5))

        if CALENDAR_AVAILABLE:
            # Use calendar picker
            self.fecha_registro_entry = DateEntry(
                fecha_registro_frame,
                width=25,
                background='darkblue',
                foreground='white',
                borderwidth=2,
                date_pattern='yyyy-mm-dd',
                font=("Arial", 11)
            )
            self.fecha_registro_entry.pack(side="left", fill="x", expand=True)

            # Update the StringVar when date changes
            def update_fecha_registro(event=None):
                self.fecha_registro_var.set(self.fecha_registro_entry.get())

            self.fecha_registro_entry.bind("<<DateEntrySelected>>", update_fecha_registro)

            # Calendar icon button
            calendar_btn2 = ctk.CTkButton(
                fecha_registro_frame,
                text="📅",
                width=40,
                height=35,
                command=lambda: self.fecha_registro_entry.drop_down(),
                fg_color=COLORS.get('primary', '#2196F3'),
                hover_color=COLORS.get('primary_hover', '#1976D2')
            )
            calendar_btn2.pack(side="left", padx=(5, 0))
        else:
            # Fallback to text entry
            self.fecha_registro_entry = ctk.CTkEntry(
                fecha_registro_frame,
                textvariable=self.fecha_registro_var,
                height=35,
                font=FONTS['body'],
                placeholder_text="YYYY-MM-DD"
            )
            self.fecha_registro_entry.pack(fill="x")

        ctk.CTkLabel(
            form_frame,
            text="ℹ️ Fecha de hoy por defecto (haz clic en 📅 para calendario)",
            font=("Arial", 10),
            text_color="gray"
        ).pack(fill="x", pady=(0, 15))
        
        # Cantidad
        ctk.CTkLabel(
            form_frame,
            text="Cantidad: *",
            font=FONTS['subheader'],
            anchor="w"
        ).pack(fill="x", pady=(0, 5))
        
        self.cantidad_entry = ctk.CTkEntry(
            form_frame,
            textvariable=self.cantidad_var,
            height=35,
            font=FONTS['body'],
            placeholder_text="Ej: 100"
        )
        self.cantidad_entry.pack(fill="x", pady=(0, 15))
        
        # Precio unitario
        ctk.CTkLabel(
            form_frame,
            text="Precio por Unidad: *",
            font=FONTS['subheader'],
            anchor="w"
        ).pack(fill="x", pady=(0, 5))
        
        precio_frame = ctk.CTkFrame(form_frame, fg_color="transparent")
        precio_frame.pack(fill="x", pady=(0, 20))
        
        ctk.CTkLabel(
            precio_frame,
            text="$",
            font=FONTS['subheader']
        ).pack(side="left", padx=(0, 5))
        
        self.precio_entry = ctk.CTkEntry(
            precio_frame,
            textvariable=self.precio_var,
            height=35,
            font=FONTS['body'],
            placeholder_text="Ej: 25.50"
        )
        self.precio_entry.pack(side="left", fill="x", expand=True)
        
        # =====================================================
        # SECCIÓN 2: INFORMACIÓN FISCAL Y PROVEEDOR
        # =====================================================
        self.create_section_header(form_frame, "🏛️ INFORMACIÓN FISCAL")
        
        # Folio de Factura
        ctk.CTkLabel(
            form_frame,
            text="Folio Fiscal (UUID) / No. Factura: *",
