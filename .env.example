# ============================================================
# DISFRULEG - Example environment configuration
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` file.
# ============================================================

# --- Modo de conexión ---
# local = MySQL/MariaDB en tu máquina (desarrollo y demos)
# cloud = Google Cloud SQL vía Cloud SQL Connector (producción)
DB_MODE=local

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=disfruleg

# --- Solo para DB_MODE=cloud ---
# Requiere credentials.json (service account con rol Cloud SQL Client)
# en la raíz del proyecto, o `gcloud auth application-default login`.
# CLOUD_SQL_CONNECTION_NAME=project-id:region:instance-name

# --- Application ---
DEBUG_MODE=false
