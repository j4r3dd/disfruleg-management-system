# ============================================================
# DISFRULEG - Example environment configuration
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` file.
# ============================================================

# --- Database (Cloud SQL or local MySQL/MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=disfruleg

# --- Optional: Google Cloud SQL connection ---
# Path to a Google service-account JSON file with Cloud SQL Client role.
# GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
# CLOUD_SQL_CONNECTION_NAME=project-id:region:instance-name

# --- Application ---
DEBUG_MODE=false
